{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set -a; . ../../.env; set +a; npm run db:migrate && npm run db:seed && npm run build && npm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "db:migrate": "bash ../../scripts/db/migrate.sh",
    "db:seed": "node --experimental-strip-types src/seed.ts",
    "test:unit": "DATABASE_URL=postgres://campus_app:campus_app@127.0.0.1:5432/campus NODE_ENV=test node --experimental-strip-types --test src/lib/*.test.ts",
    "test:integration:classroom": "node --test ../../scripts/tests/classroom.integration.mjs",
    "test:integration:academic": "node --test ../../scripts/tests/academic-scheduling.integration.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "@workspace/api-zod": "*",
    "@workspace/db": "*",
    "fastify": "5.12.7",
    "livekit-server-sdk": "^2.19.2",
    "pino": "^9.14.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
